# copy this file to .env, then change the passwords and token.
#   cp .env.example .env
# .env is git-ignored. never commit it.

# --- which plc -------------------------------------------------------------
# softplc: the silo fill ladder in python. works right away, nothing to install
# openplc: your ladder in the OpenPLC runtime. upload plc/ with OpenPLC Editor first (SETUP.md)
COMPOSE_PROFILES=softplc
PLC_HOST=softplc
# COMPOSE_PROFILES=openplc
# PLC_HOST=openplc

# --- line ------------------------------------------------------------------
# a = fill and go, b = fill and wait for start, c = no fill
LINE_MODE=a
# plant time zone, for shifts: A 6-14, B 14-22, C 22-6
PLANT_TZ=America/New_York

# --- InfluxDB --------------------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx-password
INFLUX_ORG=plantfloor
INFLUX_BUCKET=bagline1
INFLUX_TOKEN=change-me-influx-token

# --- TimescaleDB (postgres) ------------------------------------------------
PG_USER=plantfloor
PG_PASS=change-me-pg-password
PG_DB=plant

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- chat ------------------------------------------------------------------
# ollama: a local model on this computer, nothing leaves the building (install Ollama, then: ollama pull llama3.2)
# anthropic: the Claude API, needs a key, the data block leaves the network
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://host.docker.internal:11434
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
