    {
      "id": 13,
      "type": "table",
      "title": "Lots: weight and giveaway",
      "description": "one row per lot: the traceability view. short = bags under the short limit.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres_plant"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres_plant"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT l.lot_id AS lot, l.product_id AS product, l.started_at AS started, count(b.*) AS bags, round(avg(b.net_lb),2) AS avg_lb, min(b.net_lb) AS min_lb, count(*) FILTER (WHERE b.result='short') AS short, count(*) FILTER (WHERE b.result='over') AS over, round(COALESCE(sum(b.giveaway_lb),0),0) AS giveaway_lb FROM production_lot l LEFT JOIN bag_fill b ON b.lot_id = l.lot_id WHERE l.started_at > $__timeFrom()::timestamptz - interval '1 day' OR l.ended_at IS NULL GROUP BY l.lot_id, l.product_id, l.started_at ORDER BY l.started_at DESC LIMIT 30"
        }
      ],
